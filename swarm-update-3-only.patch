+          <button class="send" id="send" type="submit" aria-label="Send">↑</button>
+        </div>
+      </form>
+    </div>
+  </section>
+</div>
+
+<!-- setup wizard -->
+<div class="modal" id="modal" hidden>
+  <div class="sheet" role="dialog" aria-modal="true" aria-labelledby="setupTitle">
+    <div class="sheet-head">
+      <h2 id="setupTitle">Connect an AI provider</h2>
+      <button class="icon-btn" id="closeSetup" type="button" aria-label="Close" hidden>✕</button>
+    </div>
+
+    <!-- step 1: provider -->
+    <div id="step1">
+      <p class="muted">Pick a provider. Your API key is saved only in this browser.</p>
+      <div class="providers" id="providers"></div>
+    </div>
+
+    <!-- step 2: key -->
+    <div id="step2" hidden>
+      <p class="muted" id="step2Title"></p>
+      <label class="field-label" for="apiKey">API key</label>
+      <input class="field" id="apiKey" type="password" autocomplete="off" spellcheck="false" placeholder="Paste your key">
+      <div id="baseWrap" hidden>
+        <label class="field-label" for="baseUrl">Base URL</label>
+        <input class="field" id="baseUrl" type="url" placeholder="https://your-host.example/v1" spellcheck="false">
+      </div>
+      <p class="help" id="keyHelp"></p>
+      <p class="sheet-err" id="setupError" hidden></p>
+      <div class="row-btns">
+        <button class="btn ghost" id="back1" type="button">Back</button>
+        <button class="btn" id="verify" type="button">Load models</button>
+      </div>
+    </div>
+
+    <!-- step 3: model -->
+    <div id="step3" hidden>
+      <p class="muted">Choose a model. You can switch later from the top bar.</p>
+      <div class="model-list" id="modelList"></div>
+      <div class="row-btns">
+        <div style="display:flex; gap:8px; flex-wrap:wrap;">
+          <button class="btn ghost" id="back2" type="button">Back</button>
+          <button class="btn danger" id="removeKey" type="button">Remove key</button>
+        </div>
+        <button class="btn" id="finish" type="button">Start chatting</button>
+      </div>
+    </div>
+  </div>
+</div>
+
+<script>
+(() => {
+  "use strict";
+
+  /* ================= constants ================= */
+  const CFG_KEY = "swarm.config.v1";
+  const CHATS_KEY = "swarm.chats.v1";
+  const SYSTEM = "You are Swarm, a helpful, clear assistant. Use Markdown when it helps.";
+  const SUGGESTIONS = [
+    "Explain how a neural network learns",
+    "Draft a polite email declining a meeting",
+    "Plan a 3-day trip to Kyoto",
+    "Help me debug a JavaScript promise",
+  ];
+  const PROVIDERS = [
+    { id: "anthropic", name: "Anthropic", sub: "Claude", base: "https://api.anthropic.com/v1",
+      hint: "Create a key at console.anthropic.com." },
+    { id: "openai", name: "OpenAI", sub: "GPT models", base: "https://api.openai.com/v1",
+      hint: "Create a key at platform.openai.com/api-keys." },
+    { id: "xai", name: "xAI", sub: "Grok", base: "https://api.x.ai/v1",
+      hint: "Create a key at console.x.ai." },
+    { id: "google", name: "Google", sub: "Gemini", base: "https://generativelanguage.googleapis.com/v1beta",
+      hint: "Create a key at aistudio.google.com/apikey." },
+    { id: "custom", name: "Custom", sub: "OpenAI-compatible", base: "",
+      hint: "Any server that speaks the OpenAI chat completions API." },
+  ];
+  const OAI_SKIP = /embed|whisper|tts|dall-e|moderation|audio|image|realtime|transcribe|babbage|davinci/i;
+
+  /* ================= storage ================= */
+  const $ = (id) => document.getElementById(id);
+  const load = (k, d) => { try { const v = JSON.parse(localStorage.getItem(k)); return v ?? d; } catch { return d; } };
+  const save = (k, v) => localStorage.setItem(k, JSON.stringify(v));
+
+  let config = load(CFG_KEY, null);          // {provider, apiKey, baseUrl, model, models}
+  let chats = load(CHATS_KEY, []);           // [{id, title, messages:[{role, content}], updated}]
+  let activeId = null;
+  let controller = null;                      // AbortController while streaming
+  let draft = null;                           // wizard state
+
+  const persistChats = () => save(CHATS_KEY, chats);
+  const persistConfig = () => save(CFG_KEY, config);
+  const activeChat = () => chats.find((c) => c.id === activeId) || null;
+  const newId = () => Math.random().toString(36).slice(2, 10) + Date.now().toString(36);
+
+  /* ================= tiny DOM helper ================= */
+  function el(tag, attrs = {}, ...kids) {
+    const node = document.createElement(tag);
+    for (const [k, v] of Object.entries(attrs)) {
+      if (v === false || v == null) continue;
+      if (k === "class") node.className = v;
+      else if (k.startsWith("on")) node.addEventListener(k.slice(2), v);
+      else node.setAttribute(k, v === true ? "" : String(v));
+    }
+    for (const kid of kids.flat()) {
+      if (kid == null || kid === false) continue;
+      node.append(kid.nodeType ? kid : document.createTextNode(String(kid)));
+    }
+    return node;
+  }
+
+  /* ================= safe markdown ================= */
+  function esc(s) {
+    return s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]);
+  }
+  function fmt(s) {
+    let out = esc(s);
+    out = out.replace(/`([^`\n]+)`/g, "<code>$1</code>");
+    out = out.replace(/\*\*([^*\n]+)\*\*/g, "<strong>$1</strong>");
+    out = out.replace(/(^|[^*\w])\*([^*\s][^*\n]*?)\*(?!\w)/g, "$1<em>$2</em>");
+    return out;
+  }
+  function inlineBlocks(text) {
+    return text.split(/\n{2,}/).filter((p) => p.trim()).map((block) => {
+      const lines = block.split("\n");
+      if (lines.every((l) => /^\s*[-*] /.test(l))) {
+        return "<ul>" + lines.map((l) => "<li>" + fmt(l.replace(/^\s*[-*] /, "")) + "</li>").join("") + "</ul>";
+      }
+      if (lines.every((l) => /^\s*\d+\. /.test(l))) {
+        return "<ol>" + lines.map((l) => "<li>" + fmt(l.replace(/^\s*\d+\. /, "")) + "</li>").join("") + "</ol>";
+      }
+      const h = block.match(/^(#{1,3}) (.+)$/);
+      if (h && lines.length === 1) return "<h3>" + fmt(h[2]) + "</h3>";
+      return "<p>" + lines.map(fmt).join("<br>") + "</p>";
+    }).join("");
+  }
+  function codeBlock(lang, code) {
+    const body = esc(code.replace(/\n$/, ""));
+    return '<div class="code"><div class="code-head"><span>' + esc(lang || "text") +
+      '</span><button class="copy" type="button" data-copy>Copy</button></div><pre><code>' +
+      body + "</code></pre></div>";
+  }
+  function md(src) {
+    const re = /```([\w+-]*)\n?([\s\S]*?)(```|$)/g;
+    let html = "", last = 0, m;
+    while ((m = re.exec(src)) !== null) {
+      html += inlineBlocks(src.slice(last, m.index));
+      html += codeBlock(m[1], m[2]);
+      last = re.lastIndex;
+      if (m[0].length === 0) break;
+    }
+    return html + inlineBlocks(src.slice(last));
+  }
+
+  /* ================= provider adapters ================= */
+  async function check(res) {
+    if (res.ok) return;
+    const text = await res.text().catch(() => "");
+    let detail = text;
+    try {
+      const j = JSON.parse(text);
+      detail = j.error?.message || (typeof j.error === "string" ? j.error : "") || j.message || text;
+    } catch { /* not JSON */ }
+    const err = new Error(`HTTP ${res.status}${detail ? ": " + String(detail).slice(0, 300) : ""}`);
+    err.status = res.status;
+    throw err;
+  }
+
+  async function* sse(res) {
+    const reader = res.body.getReader();
+    const decoder = new TextDecoder();
+    let buf = "";
+    for (;;) {
+      const { value, done } = await reader.read();
+      if (done) break;
+      buf += decoder.decode(value, { stream: true });
+      let i;
+      while ((i = buf.indexOf("\n")) >= 0) {
+        const line = buf.slice(0, i).trimEnd();
+        buf = buf.slice(i + 1);
+        if (line.startsWith("data:")) yield line.slice(5).trim();
+      }
+    }
+    buf += decoder.decode();
+    for (const line of buf.split("\n")) {
+      if (line.startsWith("data:")) yield line.slice(5).trim();
+    }
+  }
+
+  // Anthropic
+  const antHeaders = (c) => ({
+    "x-api-key": c.apiKey,
+    "anthropic-version": "2023-06-01",
+    "anthropic-dangerous-direct-browser-access": "true",
+  });
+  async function antList(c) {
+    const res = await fetch(c.baseUrl + "/models?limit=100", { headers: antHeaders(c) });
+    await check(res);
+    const j = await res.json();
+    return (j.data || []).map((m) => ({ id: m.id, label: m.display_name || m.id }));
+  }
+  async function* antStream(c, messages, system, signal) {
+    const res = await fetch(c.baseUrl + "/messages", {
+      method: "POST", signal,
+      headers: { ...antHeaders(c), "Content-Type": "application/json" },
+      body: JSON.stringify({
+        model: c.model, max_tokens: 4096, stream: true, system,
+        messages: messages.map((m) => ({ role: m.role, content: m.content })),
+      }),
+    });
+    await check(res);
+    for await (const data of sse(res)) {
+      const j = JSON.parse(data);
+      if (j.type === "error") throw new Error(j.error?.message || "stream error");
+      if (j.type === "content_block_delta" && j.delta?.type === "text_delta") yield j.delta.text;
+    }
+  }
+
+  // OpenAI, xAI and custom OpenAI-compatible servers
+  async function oaiList(c) {
+    const res = await fetch(c.baseUrl + "/models", { headers: { Authorization: "Bearer " + c.apiKey } });
+    await check(res);
+    const j = await res.json();
+    return (j.data || []).map((m) => m.id).filter((id) => !OAI_SKIP.test(id)).sort()
+      .map((id) => ({ id, label: id }));
+  }
+  async function* oaiStream(c, messages, system, signal) {
+    const res = await fetch(c.baseUrl + "/chat/completions", {
+      method: "POST", signal,
+      headers: { "Content-Type": "application/json", Authorization: "Bearer " + c.apiKey },
+      body: JSON.stringify({
+        model: c.model, stream: true,
+        messages: [{ role: "system", content: system }, ...messages.map((m) => ({ role: m.role, content: m.content }))],
+      }),
+    });
+    await check(res);
+    for await (const data of sse(res)) {
+      if (data === "[DONE]") return;
+      const j = JSON.parse(data);
+      if (j.error) throw new Error(j.error.message || "stream error");
+      const delta = j.choices?.[0]?.delta?.content;
+      if (delta) yield delta;
+    }
+  }
+
+  // Google Gemini
+  const gHeaders = (c) => ({ "x-goog-api-key": c.apiKey });
+  async function gList(c) {
+    const res = await fetch(c.baseUrl + "/models?pageSize=200", { headers: gHeaders(c) });
+    await check(res);
+    const j = await res.json();
+    return (j.models || [])
+      .filter((m) => (m.supportedGenerationMethods || []).includes("generateContent"))
+      .map((m) => {
+        const id = m.name.replace(/^models\//, "");
+        return { id, label: m.displayName || id };
+      });
+  }
+  async function* gStream(c, messages, system, signal) {
+    const url = `${c.baseUrl}/models/${encodeURIComponent(c.model)}:streamGenerateContent?alt=sse`;
+    const res = await fetch(url, {
+      method: "POST", signal,
+      headers: { ...gHeaders(c), "Content-Type": "application/json" },
+      body: JSON.stringify({
+        systemInstruction: { parts: [{ text: system }] },
+        contents: messages.map((m) => ({
+          role: m.role === "assistant" ? "model" : "user",
+          parts: [{ text: m.content }],
+        })),
+      }),
+    });
+    await check(res);
+    for await (const data of sse(res)) {
+      const j = JSON.parse(data);
+      if (j.error) throw new Error(j.error.message || "stream error");
+      const text = (j.candidates?.[0]?.content?.parts || []).map((p) => p.text || "").join("");
+      if (text) yield text;
+    }
+  }
+
+  const ADAPTERS = {
+    anthropic: { list: antList, stream: antStream },
+    openai: { list: oaiList, stream: oaiStream },
+    xai: { list: oaiList, stream: oaiStream },
+    custom: { list: oaiList, stream: oaiStream },
+    google: { list: gList, stream: gStream },
+  };
+
+  function friendly(e) {
+    if (e instanceof TypeError) {
+      return "Couldn't reach the provider from this browser. Check the key and base URL, and that the provider allows browser requests.";
+    }
+    if (e.status === 401 || e.status === 403) {
+      return `The provider rejected this key (${e.status}). Check it and try again.`;
+    }
+    return e.message || "Something went wrong.";
+  }
+
+  /* ================= setup wizard ================= */
+  function showStep(n) {
+    $("step1").hidden = n !== 1;
+    $("step2").hidden = n !== 2;
+    $("step3").hidden = n !== 3;
+    $("setupTitle").textContent = n === 1 ? "Connect an AI provider" : n === 2 ? "Enter your API key" : "Pick a model";
+    $("closeSetup").hidden = !config;
+    $("setupError").hidden = true;
+  }
+
+  function openSetup() {
+    if (config) {
+      draft = { ...config, models: config.models || [] };
+      if (draft.models.length) {
+        renderModels();
+        showStep(3);
+      } else {
+        prepareKeyStep();
+        showStep(2);
+      }
+    } else {
+      draft = { provider: null, apiKey: "", baseUrl: "", model: "", models: [] };
+      renderProviders();
+      showStep(1);
+    }
+    $("modal").hidden = false;
+  }
+
+  function closeSetup() {
+    if (config) $("modal").hidden = true;
+  }
+
+  function renderProviders() {
+    $("providers").replaceChildren(...PROVIDERS.map((p) =>
+      el("button", { class: "provider", type: "button", onclick: () => pickProvider(p.id) },
+        el("span", { class: "p-name" }, p.name),
+        el("span", { class: "p-sub" }, p.sub))));
+  }
+
+  function pickProvider(id) {
+    const info = PROVIDERS.find((p) => p.id === id);
+    if (id !== draft.provider) {
+      draft.provider = id;
+      draft.apiKey = "";
+      draft.models = [];
+      draft.model = "";
+      draft.baseUrl = info.base;
+    }
+    prepareKeyStep();
+    showStep(2);
+  }
+
+  function prepareKeyStep() {
+    const info = PROVIDERS.find((p) => p.id === draft.provider);
+    $("step2Title").textContent = `${info.name} · ${info.sub}`;
+    $("keyHelp").textContent = info.hint;
+    $("apiKey").value = draft.apiKey || "";
+    $("baseWrap").hidden = draft.provider !== "custom";
+    $("baseUrl").value = draft.provider === "custom" ? (draft.baseUrl || "") : "";
+  }
+
+  function setupError(msg) {
+    $("setupError").textContent = msg;
+    $("setupError").hidden = false;
+  }
+
+  async function verifyKey() {
+    const key = $("apiKey").value.trim();
+    const base = $("baseUrl").value.trim().replace(/\/+$/, "");
+    if (!key) return setupError("Paste your API key first.");
+    if (draft.provider === "custom" && !base) return setupError("Enter the base URL for your endpoint.");
+    draft.apiKey = key;
+    draft.baseUrl = draft.provider === "custom" ? base : PROVIDERS.find((p) => p.id === draft.provider).base;
+
+    const btn = $("verify");
+    btn.disabled = true;
+    btn.textContent = "Loading…";
+    try {
+      const models = await ADAPTERS[draft.provider].list(draft);
+      if (!models.length) throw new Error("This key returned no chat models.");
+      draft.models = models;
+      if (!models.some((m) => m.id === draft.model)) draft.model = models[0].id;
+      renderModels();
+      showStep(3);
+    } catch (e) {
+      setupError(friendly(e));
+    } finally {
+      btn.disabled = false;
+      btn.textContent = "Load models";
+    }
+  }
+
+  function renderModels() {
+    $("modelList").replaceChildren(...draft.models.map((m) =>
+      el("button", {
+        class: "model-opt" + (m.id === draft.model ? " selected" : ""),
+        type: "button",
+        onclick: () => { draft.model = m.id; renderModels(); },
+      }, m.label)));
+    $("finish").disabled = !draft.model;
+  }
+
+  function finishSetup() {
+    config = {
+      provider: draft.provider,
+      apiKey: draft.apiKey,
+      baseUrl: draft.baseUrl,
+      model: draft.model,
+      models: draft.models,
+    };
+    persistConfig();
+    $("modal").hidden = true;
+    refreshModelSelect();
+    refreshSidebar();
+  }
+
+  function removeKey() {
+    config = null;
+    localStorage.removeItem(CFG_KEY);
+    refreshModelSelect();
+    openSetup();
+  }
+
+  /* ================= top bar ================= */
+  function refreshModelSelect() {
+    const sel = $("modelSelect");
+    if (!config) {
+      sel.replaceChildren(el("option", { value: "" }, "Set up a provider"));
+      sel.disabled = true;
+      return;
+    }
+    sel.disabled = false;
+    const models = config.models?.length ? config.models : [{ id: config.model, label: config.model }];
+    sel.replaceChildren(...models.map((m) => el("option", { value: m.id, selected: m.id === config.model }, m.label)));
+  }
+
+  /* ================= sidebar ================= */
+  function refreshSidebar() {
+    const list = $("history");
+    list.replaceChildren(...chats.map((c) =>
+      el("div", { class: "hist-item" + (c.id === activeId ? " active" : ""), onclick: () => selectChat(c.id) },
+        el("span", { class: "hist-title" }, c.title || "New chat"),
+        el("button", {
+          class: "hist-del", type: "button", title: "Delete chat", "aria-label": "Delete chat",
+          onclick: (e) => { e.stopPropagation(); deleteChat(c.id); },
+        }, "✕"))));
+  }
+
+  function selectChat(id) {
+    if (controller) return;
+    activeId = id;
+    renderAll();
+    closeSideOnMobile();
+  }
+
+  function newChat() {
+    if (controller) return;
+    activeId = null;
+    renderAll();
+    $("input").focus();
+    closeSideOnMobile();
+  }
+
+  function deleteChat(id) {
+    if (controller && id === activeId) return;
+    chats = chats.filter((c) => c.id !== id);
+    if (activeId === id) activeId = null;
+    persistChats();
+    renderAll();
+  }
+
+  function closeSideOnMobile() {
+    if (matchMedia("(max-width: 820px)").matches) $("app").classList.remove("side-open");
+  }
+
+  /* ================= thread ================= */
+  function renderAll() {
+    refreshSidebar();
+    renderThread();
+  }
+
+  function renderThread() {
+    const chat = activeChat();
+    const thread = $("thread");
+    const empty = $("empty");
+    thread.replaceChildren();
+    if (!chat || !chat.messages.length) {
+      thread.hidden = true;
+      empty.hidden = false;
+      return;
+    }
+    empty.hidden = true;
+    thread.hidden = false;
+    for (const m of chat.messages) thread.append(messageNode(m));
+    scrollToEnd(true);
+  }
+
+  function messageNode(m) {
+    if (m.role === "user") {
+      return el("div", { class: "row user" }, el("div", { class: "bubble" }, m.content));
+    }
+    const prose = el("div", { class: "prose" });
+    prose.innerHTML = md(m.content);
+    return el("div", { class: "row assistant" }, prose);
+  }
+
+  function pendingAssistant() {
+    const prose = el("div", { class: "prose" }, el("span", { class: "caret" }));
+    $("thread").append(el("div", { class: "row assistant" }, prose));
+    return prose;
+  }
+
+  function setProse(prose, text) {
+    prose.innerHTML = md(text);
+    prose.append(el("span", { class: "caret" }));
+  }
+
+  function scrollToEnd(force) {
+    const s = $("scroll");
+    const nearBottom = s.scrollHeight - s.scrollTop - s.clientHeight < 120;
+    if (force || nearBottom) s.scrollTop = s.scrollHeight;
+  }
+
+  function notice(msg) {
+    const n = $("notice");
+    n.textContent = msg;
+    n.hidden = !msg;
+    if (msg) setTimeout(() => { if (n.textContent === msg) n.hidden = true; }, 8000);
+  }
+
+  function setBusy(busy) {
+    const btn = $("send");
+    btn.textContent = busy ? "■" : "↑";
+    btn.setAttribute("aria-label", busy ? "Stop" : "Send");
+    btn.disabled = false;
+  }
+
+  /* ================= sending ================= */
+  async function send(raw) {
+    const text = raw.trim();
+    if (!text || controller) return;
+    if (!config) return openSetup();
+
+    let chat = activeChat();
+    if (!chat) {
+      chat = { id: newId(), title: text.slice(0, 60), messages: [], updated: Date.now() };
+      chats.unshift(chat);
+      activeId = chat.id;
+    }
+    chat.messages.push({ role: "user", content: text });
+    chat.updated = Date.now();
+    persistChats();
+    $("input").value = "";
+    autosize();
+    renderAll();
+
+    const prose = pendingAssistant();
+    scrollToEnd(true);
+    controller = new AbortController();
+    setBusy(true);
+    let acc = "";
+    try {
+      const stream = ADAPTERS[config.provider].stream;
+      for await (const delta of stream(config, chat.messages, SYSTEM, controller.signal)) {
+        acc += delta;
+        setProse(prose, acc);
+        scrollToEnd(false);
+      }
+      if (!acc) throw new Error("The model returned an empty response.");
+      chat.messages.push({ role: "assistant", content: acc });
+    } catch (e) {
+      if (e.name === "AbortError") {
+        if (acc) chat.messages.push({ role: "assistant", content: acc });
+      } else {
+        // Undo the user turn so the conversation stays valid, and restore the text.
+        chat.messages.pop();
+        if (!chat.messages.length) {
+          chats = chats.filter((c) => c.id !== chat.id);
+          activeId = null;
+        }
+        $("input").value = text;
+        autosize();
+        notice(friendly(e));
+      }
+    } finally {
+      controller = null;
+      setBusy(false);
+      persistChats();
+      renderAll();
+      $("input").focus();
+    }
+  }
+
+  function autosize() {
+    const t = $("input");
+    t.style.height = "auto";
+    t.style.height = Math.min(t.scrollHeight, 200) + "px";
+  }
+
+  /* ================= wiring ================= */
+  $("composer").addEventListener("submit", (e) => {
+    e.preventDefault();
+    if (controller) { controller.abort(); return; }
+    send($("input").value);
+  });
+
+  $("input").addEventListener("keydown", (e) => {
+    if (e.key === "Enter" && !e.shiftKey && !e.isComposing) {
+      e.preventDefault();
+      $("composer").requestSubmit();
+    }
+  });
+  $("input").addEventListener("input", autosize);
+
+  $("thread").addEventListener("click", (e) => {
+    const btn = e.target.closest("[data-copy]");
+    if (!btn) return;
+    const code = btn.closest(".code").querySelector("code").textContent;
+    navigator.clipboard?.writeText(code).catch(() => {});
+    btn.textContent = "Copied";
+    setTimeout(() => { btn.textContent = "Copy"; }, 1500);
+  });
+
+  $("chips").replaceChildren(...SUGGESTIONS.map((s) =>
+    el("button", { class: "chip", type: "button", onclick: () => send(s) }, s)));
+
+  $("newChat").addEventListener("click", newChat);
+  $("openSettings").addEventListener("click", openSetup);
+  $("toggleSide").addEventListener("click", () => {
+    const app = $("app");
+    if (matchMedia("(max-width: 820px)").matches) app.classList.toggle("side-open");
+    else app.classList.toggle("collapsed");
+  });
+
+  $("modelSelect").addEventListener("change", (e) => {
+    if (!config) return;
+    config.model = e.target.value;
+    persistConfig();
+  });
+
+  $("back1").addEventListener("click", () => { renderProviders(); showStep(1); });
+  $("verify").addEventListener("click", verifyKey);
+  $("apiKey").addEventListener("keydown", (e) => { if (e.key === "Enter") verifyKey(); });
+  $("back2").addEventListener("click", () => { prepareKeyStep(); showStep(2); });
+  $("removeKey").addEventListener("click", removeKey);
+  $("finish").addEventListener("click", finishSetup);
+  $("closeSetup").addEventListener("click", closeSetup);
+  $("modal").addEventListener("click", (e) => { if (e.target === $("modal")) closeSetup(); });
+  document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeSetup(); });
+
+  /* ================= boot ================= */
+  chats.sort((a, b) => b.updated - a.updated);
+  if (chats.length) activeId = chats[0].id;
+  refreshModelSelect();
+  renderAll();
+  if (!config) openSetup();
+})();
+</script>
+</body>
+</html>
