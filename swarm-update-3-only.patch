+    border: 1px solid var(--line); border-radius: 999px;
+    padding: 11px 18px; font: inherit; outline: none; transition: border-color .15s;
+  }
+  input::placeholder { color: var(--dim); }
+  input:focus { border-color: #3a3a44; }
